# ==============================================================================
# MCS Deployment Secrets & Configuration (mcs-deploy.secrets.env)
# Target Server: Contabo VPS (hosting Coolify + Pulzz + Cloudflare Tunnel)
# ==============================================================================

# --- VPS Connection ---
VPS_IP=
VPS_SSH_PORT=22
VPS_SSH_USER=root
# Optional: if SSH key is not yet installed on the VPS, set root password for 1-time bootstrap
VPS_ROOT_PASSWORD=

# --- Domain & Cloudflare ---
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_DOMAIN=mcsolutions.stream
TUNNEL_NAME=tvinsights-coolify

# Service Hostnames
OS_HOSTNAME=os.mcsolutions.stream
ERP_HOSTNAME=erp.mcsolutions.stream

# --- Coolify Credentials ---
# Required only if the token is not already present on the server
COOLIFY_HOSTNAME=coolify.pulzz.stream
COOLIFY_ADMIN_EMAIL=
COOLIFY_ADMIN_PASSWORD=

# --- GitHub Repositories & Deploy Access ---
GITHUB_TOKEN=
GITHUB_REPO_OS=ainatunde/mcs-os
GITHUB_REPO_ERP=ainatunde/MCS-ERP
GIT_BRANCH=main

# --- Application Secrets (Leave empty to have deploy-mcs.ps1 auto-generate secure values) ---
POSTGRES_PASSWORD=
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=
MCS_CONTROL_API_TOKEN=
MCS_WEBHOOK_SECRET=

# --- Resource Tuning (defaults to low-RAM VPS profile) ---
FRAPPE_WORKERS=2
DB_BUFFER_POOL=512M
