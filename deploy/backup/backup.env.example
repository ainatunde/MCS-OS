# /etc/mcs-backup/backup.env  (root:root 600) — read by mcs-backup.sh
#
# age PUBLIC key (starts with "age1"). Generate the key pair on your own machine with
# `age-keygen -o mcs-backup.key`; keep the private key OFF this server (password manager + offline copy).
AGE_RECIPIENT=

# rclone remote and bucket. install.sh writes the "r2" remote from the R2_* values below.
RCLONE_REMOTE=r2:mcs-backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Coolify application ids (container names are <service>-<id>-<deploy stamp>).
PULZZ_APP=4ku1b7c85euxgtycju3zjs52
OS_APP=ddurgt39q2ypwz6761bdypib
ERP_APP=ojyst8fo3bwocewh6sxiwlzz
ERP_SITE=erp.mcsolutions.stream

# Optional off-host dead man's switch (e.g. a healthchecks.io check URL). Strongly recommended: the
# Guardian runs on this same VPS and cannot tell you the VPS is gone.
HEARTBEAT_URL=

# Optional overrides
# WORK_ROOT=/var/backups/mcs
# STATE_DIR=/var/lib/mcs-backup
# MIN_FREE_MB=3072
# KEEP_LOCAL=2
