MCS_OS_ENV=production
MCS_OS_AUTH_REQUIRED=1
MCS_CONTROL_API_TOKEN=replace-with-32-byte-hex-token
MCS_WEBHOOK_SECRET=replace-with-32-byte-hmac-secret
MCS_CORS_ORIGINS=https://os.mcsolutions.stream,https://command.mcsolutions.stream
HTTP_BIND=127.0.0.1
HTTP_PORT=8090
DATABASE_URL=postgresql+psycopg://mcs_policy_role:replace-password@db:5432/mcs_os
POSTGRES_PASSWORD=replace-password
ERPNEXT_URL=http://127.0.0.1:8080
ERPNEXT_API_KEY=replace-key
ERPNEXT_API_SECRET=replace-secret
# JSON mapping of verified ERP usernames to console roles. No passwords or API keys.
# Configure explicitly in production; an empty map denies all individual sign-ins.
MCS_ROLE_BINDINGS={}
# Generate once with Fernet.generate_key(); rotate only after session revocation.
MCS_SESSION_ENCRYPTION_KEY=replace-with-fernet-key
PULZZ_URL=https://pulzz.stream
MCS_PULZZ_SERVICE_TOKEN=replace-with-separate-32-byte-token
MCS_PULZZ_RECEIPT_TOKEN=replace-with-separate-32-byte-token
MCS_PULZZ_SIGNING_SECRET=replace-with-separate-32-byte-secret
MCS_ERP_GATEWAY_URL=http://erp-gateway:8010
MCS_ERP_GATEWAY_TOKEN=replace-with-separate-32-byte-token
MCS_ERP_SIGNING_SECRET=replace-with-separate-32-byte-secret
ERP_COMPANY=Multimedia Cloud Solutions Ltd.
